# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Cron Jobs (for settlement cascade) - generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-key

# JWT Session Token - generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# CORS (set to your production domain)
ALLOWED_ORIGIN=http://localhost:3000

# Error Tracking (Sentry) - optional but recommended for production
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=auction-house
